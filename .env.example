# =====================================================================
# PromptGuard / RedLLM Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# =====================================================================

# --- Option 1: Groq Cloud (Free & Fast - Recommended) ---
OPENAI_CHAT_ENDPOINT="https://api.groq.com/openai/v1"
OPENAI_CHAT_KEY="gsk_your_groq_api_key_here"
OPENAI_CHAT_MODEL="llama-3.3-70b-versatile"

# --- Option 2: OpenAI Direct ---
# OPENAI_CHAT_ENDPOINT="https://api.openai.com/v1"
# OPENAI_CHAT_KEY="sk-proj-your_openai_api_key_here"
# OPENAI_CHAT_MODEL="gpt-4o-mini"

# --- Option 3: Local Ollama (100% Offline) ---
# OPENAI_CHAT_ENDPOINT="http://localhost:11434/v1"
# OPENAI_CHAT_KEY="ollama"
# OPENAI_CHAT_MODEL="llama3.1"

# --- Application & Guard Settings ---
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
DATABASE_PATH="database/audit_logs.db"
CANARY_TOKEN="SECRET_CANARY_TOKEN_XYZ_999"
PROMPTGUARD_STRICT_MODE="true"
# Cosine similarity threshold for the semantic jailbreak detector (0.0–1.0).
# Lower = more sensitive but more false positives. Default: 0.75
SEMANTIC_GUARD_THRESHOLD="0.75"
